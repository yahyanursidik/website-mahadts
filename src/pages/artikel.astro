---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('artikel');
const sortedArticles = allArticles.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
);
const featuredArticle = sortedArticles[0];
const regularArticles = sortedArticles.slice(1);
const categoryCounts = sortedArticles.reduce<Record<string, number>>((counts, article) => {
  const category = article.data.category || 'Artikel';
  counts[category] = (counts[category] || 0) + 1;
  return counts;
}, {});

const formatDate = (date: string | Date) =>
  new Date(date).toLocaleDateString('id-ID', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<Layout title="Artikel - MTQ Tarbiyah Sunnah">
  <main>
    <header class="page-shell article-header">
      <p class="eyebrow">Catatan Ma’had</p>
      <h1>Artikel &amp; wawasan</h1>
      <p class="lede">
        Tulisan tentang tahfizh, adab, parenting Islami, serta kabar dari
        Ma’had Tahfizhul Qur’an Tarbiyah Sunnah.
      </p>
    </header>

    {featuredArticle ? (
      <>
        <section class="page-shell featured-story" aria-labelledby="featured-title">
          <div class="featured-story__visual">
            {featuredArticle.data.coverImage ? (
              <img
                src={featuredArticle.data.coverImage}
                alt=""
                width="960"
                height="720"
                loading="eager"
              />
            ) : (
              <div class="featured-story__monogram" aria-hidden="true">TS</div>
            )}
          </div>
          <div class="featured-story__copy">
            <p class="article-meta">
              <span>{featuredArticle.data.category || 'Artikel'}</span>
              <time datetime={String(featuredArticle.data.date)}>
                {formatDate(featuredArticle.data.date)}
              </time>
            </p>
            <h2 id="featured-title">
              <a href={`/artikel/${featuredArticle.id}`}>{featuredArticle.data.title}</a>
            </h2>
            <p>{featuredArticle.data.summary}</p>
            <a class="text-link" href={`/artikel/${featuredArticle.id}`}>Baca artikel <span aria-hidden="true">→</span></a>
          </div>
        </section>

        <section class="page-section page-section--tint">
          <div class="page-shell article-index">
            <aside aria-labelledby="category-title">
              <p class="eyebrow" id="category-title">Indeks topik</p>
              <dl class="category-index">
                {Object.entries(categoryCounts).map(([category, count]) => (
                  <div>
                    <dt>{category}</dt>
                    <dd>{String(count).padStart(2, '0')}</dd>
                  </div>
                ))}
              </dl>
            </aside>
            <div>
              <header class="article-index__heading">
                <p class="eyebrow">Arsip terbaru</p>
                <h2>Semua tulisan</h2>
              </header>
              {regularArticles.length > 0 ? (
                <ol class="story-list">
                  {regularArticles.map((article) => (
                    <li>
                      <div>
                        <p class="article-meta">
                          <span>{article.data.category || 'Artikel'}</span>
                          <time datetime={String(article.data.date)}>{formatDate(article.data.date)}</time>
                        </p>
                        <h3><a href={`/artikel/${article.id}`}>{article.data.title}</a></h3>
                        <p>{article.data.summary}</p>
                      </div>
                      <a
                        class="story-list__arrow"
                        href={`/artikel/${article.id}`}
                        aria-label={`Baca ${article.data.title}`}
                      >
                        →
                      </a>
                    </li>
                  ))}
                </ol>
              ) : (
                <p class="empty-note">
                  Artikel berikutnya sedang disiapkan. Silakan kembali lagi
                  untuk membaca catatan terbaru dari Ma’had.
                </p>
              )}
            </div>
          </div>
        </section>
      </>
    ) : (
      <section class="page-section page-shell">
        <p class="empty-note">Belum ada artikel yang dipublikasikan.</p>
      </section>
    )}
  </main>
</Layout>

<style>
  /* hallmark: scope=artikel-index | critique=P5 H4 E4 S5 R5 V4 */
  .article-header {
    padding-block: clamp(3.5rem, 8vw, 8rem) clamp(2.5rem, 5vw, 5rem);
    border-bottom: 1px solid var(--color-rule);
  }
  .article-header h1 {
    max-width: 12ch;
    font-size: var(--text-display-s);
    line-height: 1.06;
  }
  .article-header .lede { max-width: 44rem; }
  .featured-story {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
    min-height: 34rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .featured-story__visual {
    min-height: 30rem;
    overflow: hidden;
    background: var(--color-paper-3);
  }
  .featured-story__visual img { width: 100%; height: 100%; object-fit: cover; }
  .featured-story__monogram {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--color-ink);
    font: 700 clamp(6rem, 18vw, 13rem)/1 var(--font-display);
    letter-spacing: -.08em;
  }
  .featured-story__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 6vw, 6rem);
  }
  .featured-story__copy h2 {
    margin: var(--space-5) 0;
    font-size: clamp(var(--text-xl), 3vw, var(--text-3xl));
    line-height: 1.14;
  }
  .featured-story__copy h2 a { color: inherit; text-decoration: none; }
  .featured-story__copy > p:not(.article-meta) { color: var(--color-ink-2); }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    color: var(--color-ink-2);
    font: 700 var(--text-xs)/1.4 var(--font-body);
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .article-meta span { color: var(--color-accent); }
  .text-link {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    width: fit-content;
    margin-top: var(--space-5);
    color: var(--color-accent);
    font-weight: 700;
    text-decoration-thickness: .08em;
    text-underline-offset: .22em;
  }
  .article-index {
    display: grid;
    grid-template-columns: minmax(12rem, .55fr) minmax(0, 1.45fr);
    gap: clamp(3rem, 8vw, 8rem);
  }
  .category-index { margin: var(--space-5) 0 0; }
  .category-index div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-rule);
  }
  .category-index div:last-child { border-bottom: 1px solid var(--color-rule); }
  .category-index dd { color: var(--color-accent); font-weight: 700; }
  .article-index__heading { margin-bottom: var(--space-7); }
  .story-list { list-style: none; padding: 0; margin: 0; }
  .story-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-rule);
  }
  .story-list li:last-child { border-bottom: 1px solid var(--color-rule); }
  .story-list h3 { margin: var(--space-3) 0; }
  .story-list h3 a { color: inherit; text-decoration: none; }
  .story-list p:last-child { max-width: 42rem; margin: 0; color: var(--color-ink-2); }
  .story-list__arrow { align-self: center; font-size: var(--text-xl); text-decoration: none; }
  .empty-note {
    max-width: 42rem;
    padding-block: var(--space-6);
    border-block: 1px solid var(--color-rule);
    color: var(--color-ink-2);
  }
  @media (max-width: 48rem) {
    .featured-story { grid-template-columns: 1fr; }
    .featured-story__visual { min-height: 18rem; }
    .article-index { grid-template-columns: 1fr; }
  }
</style>
