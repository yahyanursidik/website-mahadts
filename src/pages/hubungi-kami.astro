---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getSiteSettings } from '../lib/site-settings';

const settings = await getSiteSettings();
const content = settings.content.contact;
const address = settings.footer.address;
const whatsapp = settings.footer.phone;
const email = settings.footer.email;
---

<Layout title="Hubungi Kami - MTQ Tarbiyah Sunnah">
  <main>
    <section class="page-shell contact-hero">
      <div>
        <p class="eyebrow">{content.eyebrow}</p>
        <h1>{content.heroTitle}</h1>
      </div>
      <p class="lede">
        {content.heroLede}
      </p>
    </section>

    <section class="page-section page-section--tint">
      <div class="page-shell contact-directory">
        <div class="contact-directory__intro">
          <p class="eyebrow">{content.directoryEyebrow}</p>
          <h2>{content.directoryTitle}</h2>
          <p>{content.directoryText}</p>
        </div>
        <dl class="contact-list">
          <div>
            <dt>Alamat Ma’had</dt>
            <dd id="address-value">{address}</dd>
            <button class="copy-link" type="button" data-copy={address}>Salin alamat</button>
          </div>
          <div>
            <dt>WhatsApp admin</dt>
            <dd>{whatsapp}</dd>
            <span class="contact-list__actions">
              <a
                href={settings.footer.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Mulai percakapan
              </a>
              <button class="copy-link" type="button" data-copy={whatsapp}>Salin nomor</button>
            </span>
          </div>
          <div>
            <dt>Email resmi</dt>
            <dd>{email}</dd>
            <span class="contact-list__actions">
              <a href={`mailto:${email}`}>Kirim email</a>
              <button class="copy-link" type="button" data-copy={email}>Salin email</button>
            </span>
          </div>
          <div>
            <dt>Waktu kunjungan</dt>
            <dd>{content.visitHours}</dd>
            <p>{content.visitHelp}</p>
          </div>
        </dl>
      </div>
    </section>

    <section class="page-section page-shell map-section" aria-labelledby="map-title">
      <header class="map-section__heading">
        <div>
          <p class="eyebrow">Lokasi</p>
          <h2 id="map-title">{content.mapTitle}</h2>
        </div>
        <a
          class="button button--secondary"
          href="https://maps.google.com/?q=Ma%27had+Tahfizhul+Qur%27an+Tarbiyah+Sunnah"
          target="_blank"
          rel="noopener noreferrer"
        >
          Buka petunjuk arah
        </a>
      </header>
      <div class="map-frame">
        <iframe
          title="Peta lokasi Ma’had Tahfizhul Qur’an Tarbiyah Sunnah"
          src={settings.seo.googleMapsUrl}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </section>

    <p class="copy-status" role="status" aria-live="polite" hidden></p>
  </main>
</Layout>

<script>
  const status = document.querySelector<HTMLElement>('.copy-status');
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy]');
  let statusTimer: number | undefined;

  copyButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const value = button.dataset.copy;
      if (!value || !status) return;

      try {
        await navigator.clipboard.writeText(value);
        status.textContent = 'Berhasil disalin.';
      } catch {
        status.textContent = 'Belum dapat menyalin. Silakan salin secara manual.';
      }

      status.hidden = false;
      window.clearTimeout(statusTimer);
      statusTimer = window.setTimeout(() => {
        status.hidden = true;
      }, 2500);
    });
  });
</script>

<style>
  /* hallmark: scope=kontak | critique=P5 H4 E4 S5 R5 V4 */
  .contact-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, .85fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
    padding-block: clamp(3.5rem, 8vw, 8rem);
  }
  .contact-hero h1 {
    max-width: 15ch;
    font-size: var(--text-display-s);
    line-height: 1.06;
  }
  .contact-hero .lede { margin: 0; }
  .contact-directory {
    display: grid;
    grid-template-columns: minmax(14rem, .65fr) minmax(0, 1.35fr);
    gap: clamp(3rem, 8vw, 8rem);
  }
  .contact-directory__intro > p:last-child {
    max-width: 30rem;
    color: var(--color-ink-2);
  }
  .contact-list { margin: 0; border-top: 1px solid var(--color-rule); }
  .contact-list > div {
    display: grid;
    grid-template-columns: minmax(8rem, .55fr) minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-rule);
  }
  .contact-list dt {
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .contact-list dd {
    margin: 0;
    color: var(--color-ink);
    font-weight: 700;
  }
  .contact-list p { grid-column: 2; margin: 0; color: var(--color-ink-2); }
  .contact-list__actions {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .contact-list a,
  .copy-link {
    color: var(--color-accent);
    font: 700 var(--text-sm)/1.4 var(--font-body);
    text-decoration: underline;
    text-decoration-thickness: .08em;
    text-underline-offset: .2em;
  }
  .copy-link {
    appearance: none;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .map-section { padding-block: clamp(3rem, 7vw, 7rem); }
  .map-section__heading {
    display: flex;
    justify-content: space-between;
    gap: var(--space-6);
    align-items: end;
    margin-bottom: var(--space-7);
  }
  .map-frame {
    height: clamp(22rem, 55vw, 38rem);
    overflow: hidden;
    border: 1px solid var(--color-rule);
  }
  .map-frame iframe { width: 100%; height: 100%; border: 0; }
  .copy-status {
    position: fixed;
    z-index: var(--z-toast);
    right: var(--space-5);
    bottom: var(--space-5);
    max-width: min(22rem, calc(100vw - 2rem));
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: 0 var(--space-xs) var(--space-xl) var(--color-shadow);
  }
  @media (max-width: 48rem) {
    .contact-hero,
    .contact-directory { grid-template-columns: 1fr; }
    .contact-list > div { grid-template-columns: 1fr; gap: var(--space-2); }
    .contact-list p,
    .contact-list__actions { grid-column: 1; }
    .map-section__heading { align-items: stretch; flex-direction: column; }
    .map-section__heading .button { width: 100%; }
  }
</style>
