---
import Layout from '../../layouts/Layout.astro';
import { getCmsContent, renderTiptapDocument } from '../../lib/cms-articles';

export async function getStaticPaths() {
  const pages = await getCmsContent('pages');
  return (pages ?? []).map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---

<Layout title={`${page.title} - MTQ Tarbiyah Sunnah`} description={page.summary} image={page.coverImage}>
  <main>
    <article>
      <header class="dynamic-hero page-shell">
        <p class="eyebrow">Informasi Ma’had</p>
        <h1>{page.title}</h1>
        {page.summary && <p class="lede">{page.summary}</p>}
      </header>
      {page.coverImage && <figure class="dynamic-cover page-shell"><img src={page.coverImage} alt="" width="1280" height="720" loading="eager" /></figure>}
      <div class="article-prose" set:html={renderTiptapDocument(page.body)} />
    </article>
  </main>
</Layout>

<style>
  .dynamic-hero { padding-block: clamp(3.5rem, 8vw, 8rem) clamp(2.5rem, 5vw, 5rem); border-bottom: 1px solid var(--color-rule); }
  .dynamic-hero h1 { max-width: 16ch; font-size: var(--text-display-s); line-height: 1.06; }
  .dynamic-hero .lede { max-width: 44rem; }
  .dynamic-cover { max-width: 80rem; padding-top: var(--space-7); }
  .dynamic-cover img { width: 100%; max-height: 42rem; object-fit: cover; }
</style>
