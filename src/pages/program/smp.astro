---
import Layout from '../../layouts/Layout.astro';
import pengaturanHalaman from '../../content/pengaturanHalaman/data.json';
import pengaturanUtama from '../../content/pengaturanUtama/data.json';

const curriculum = [
  ['Tahfizh Al-Qur’an', 'Target hafalan mutqin minimal 20 juz melalui ziyadah dan muraja’ah yang terstruktur.'],
  ['Dirosah Islamiyah', 'Aqidah, fiqih, sirah, dan adab berlandaskan pemahaman manhaj salafus shalih.'],
  ['Bahasa Arab', 'Nahwu, shorof, dan muhadatsah sebagai dasar memahami literatur Islam.'],
  ['Pendidikan Akademik', 'Kurikulum nasional untuk membekali santri melanjutkan pendidikan ke jenjang berikutnya.'],
];

const outcomes = [
  ['Hafal 20 juz', 'Bacaan tartil dan mutqin sesuai kaidah tajwid.'],
  ['Berakidah lurus', 'Pemahaman agama sesuai manhaj salaful ummah.'],
  ['Bahasa Arab dasar', 'Mampu memahami kaidah dan literatur syar’i dasar.'],
  ['Ijazah formal SMP', 'Ijazah kelulusan yang diakui negara.'],
];
---

<Layout title="Program SMP - MTQ Tarbiyah Sunnah">
  <main>
    <section class="split-hero">
      <div class="split-hero__copy">
        <h1>SMP Tahfizh untuk pondasi yang kokoh.</h1>
        <p class="split-hero__lede">
          Tahfizh Al-Qur’an intensif, dirosah islamiyah, bahasa Arab, dan
          pendidikan akademik formal dalam pembinaan asrama.
        </p>
        <div class="split-hero__actions">
          <a class="button button--primary" href={pengaturanUtama.linkSpmb || 'https://hub.mahadtarbiyahsunnah.com/login/spmb'}>Daftar SPMB</a>
          <a
            class="button button--secondary"
            href={pengaturanUtama.linkBrosur || pengaturanUtama.linkSpmb || 'https://hub.mahadtarbiyahsunnah.com/login/spmb'}
            target={pengaturanUtama.linkBrosur ? '_blank' : undefined}
            rel={pengaturanUtama.linkBrosur ? 'noopener noreferrer' : undefined}
          >
            Lihat brosur
          </a>
        </div>
      </div>
      <figure class="split-hero__media">
        <img
          src={pengaturanHalaman.heroSmp}
          alt="Kegiatan santri Program SMP Tahfizh"
          width="1600"
          height="1200"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="page-section page-section--paper-2">
      <div class="page-shell">
        <div class="section-heading">
          <h2>Kurikulum yang saling menguatkan.</h2>
          <p>Ilmu syar’i dan akademik dipelajari sebagai satu bekal pendidikan santri.</p>
        </div>
        <div class="programme-spec">
          {curriculum.map(([title, description]) => (
            <article>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="page-shell media-split media-split--reverse">
        <figure class="media-split__figure">
          <img
            src={pengaturanHalaman.gambarSejarahProfil}
            alt="Pembelajaran dan pembinaan santri SMP"
            width="1200"
            height="900"
            loading="lazy"
          />
        </figure>
        <div class="media-split__copy">
          <h2>Profil lulusan SMP</h2>
          <p>
            Lulusan disiapkan agar kuat dalam hafalan, lurus dalam akidah,
            memahami bahasa Arab dasar, dan siap melanjutkan pendidikan.
          </p>
          <dl class="outcome-list">
            {outcomes.map(([title, description]) => (
              <div>
                <dt>{title}</dt>
                <dd>{description}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="page-section page-section--ink">
      <div class="page-shell programme-cta">
        <div>
          <h2>Mulai dari informasi yang jelas.</h2>
          <p>Pelajari alur pendaftaran, berkas, dan tahapan seleksi santri baru.</p>
        </div>
        <a class="button button--secondary" href={pengaturanUtama.linkSpmb || 'https://hub.mahadtarbiyahsunnah.com/login/spmb'}>Buka panduan SPMB</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Hallmark · genre: editorial · macrostructure: Split Studio · design-system: design.md · designed-as-app */
  .programme-spec {
    display: grid;
    border-block-start: var(--rule-hair) solid var(--color-rule-strong);
  }

  .programme-spec article {
    padding-block: var(--space-lg);
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  .programme-spec h3 {
    margin-block-end: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-md);
  }

  .programme-spec p,
  .outcome-list dd {
    color: var(--color-ink-2);
  }

  .outcome-list {
    margin: 0;
    display: grid;
  }

  .outcome-list div {
    padding-block: var(--space-md);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .outcome-list dt {
    color: var(--color-accent);
    font-weight: 700;
  }

  .outcome-list dd {
    margin: var(--space-xs) 0 0;
  }

  .programme-cta {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .programme-cta h2 {
    color: var(--color-paper);
    font-size: clamp(var(--text-xl), 3vw, var(--text-3xl));
  }

  .programme-cta p {
    max-width: 55ch;
    margin-block-start: var(--space-sm);
    color: var(--color-paper);
  }

  .programme-cta .button {
    width: fit-content;
    border-color: var(--color-paper);
    color: var(--color-paper);
  }

  @media (min-width: 40rem) {
    .programme-spec {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .programme-spec article:nth-child(odd) {
      padding-inline-end: var(--space-xl);
    }

    .programme-spec article:nth-child(even) {
      padding-inline-start: var(--space-xl);
      border-inline-start: var(--rule-hair) solid var(--color-rule);
    }
  }

  @media (min-width: 60rem) {
    .programme-cta {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
