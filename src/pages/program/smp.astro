---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getSiteSettings } from '../../lib/site-settings';
import { pairs } from '../../lib/content-format';

const settings = await getSiteSettings();
const content = settings.content.smp;
const curriculum = pairs(content.curriculum);
const outcomes = pairs(content.outcomes);
---

<Layout title="Program SMP - MTQ Tarbiyah Sunnah">
  <main>
    <section class="split-hero">
      <div class="split-hero__copy">
        <h1>{content.heroTitle}</h1>
        <p class="split-hero__lede">
          {content.heroLede}
        </p>
        <div class="split-hero__actions">
          <a class="button button--primary" href={settings.header.spmbUrl}>Daftar SPMB</a>
          <a
            class="button button--secondary"
            href={settings.header.brochureUrl || settings.header.spmbUrl}
            target={settings.header.brochureUrl ? '_blank' : undefined}
            rel={settings.header.brochureUrl ? 'noopener noreferrer' : undefined}
          >
            Lihat brosur
          </a>
        </div>
      </div>
      <figure class="split-hero__media">
        <img
          src={settings.pages.smpHeroUrl}
          alt="Kegiatan santri Program SMP Tahfizh"
          width="1600"
          height="1200"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="page-section page-section--paper-2">
      <div class="page-shell">
        <div class="section-heading">
          <h2>{content.curriculumTitle}</h2>
          <p>{content.curriculumLede}</p>
        </div>
        <div class="programme-spec">
          {curriculum.map(([title, description]) => (
            <article>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="page-shell media-split media-split--reverse">
        <figure class="media-split__figure">
          <img
            src={settings.pages.historyImageUrl}
            alt="Pembelajaran dan pembinaan santri SMP"
            width="1200"
            height="900"
            loading="lazy"
          />
        </figure>
        <div class="media-split__copy">
          <h2>{content.graduateTitle}</h2>
          <p>{content.graduateText}</p>
          <dl class="outcome-list">
            {outcomes.map(([title, description]) => (
              <div>
                <dt>{title}</dt>
                <dd>{description}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="page-section page-section--ink">
      <div class="page-shell programme-cta">
        <div>
          <h2>{content.ctaTitle}</h2>
          <p>{content.ctaText}</p>
        </div>
        <a class="button button--secondary" href={settings.header.spmbUrl}>Buka panduan SPMB</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Hallmark · genre: editorial · macrostructure: Split Studio · design-system: design.md · designed-as-app */
  .programme-spec {
    display: grid;
    border-block-start: var(--rule-hair) solid var(--color-rule-strong);
  }

  .programme-spec article {
    padding-block: var(--space-lg);
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  .programme-spec h3 {
    margin-block-end: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-md);
  }

  .programme-spec p,
  .outcome-list dd {
    color: var(--color-ink-2);
  }

  .outcome-list {
    margin: 0;
    display: grid;
  }

  .outcome-list div {
    padding-block: var(--space-md);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .outcome-list dt {
    color: var(--color-accent);
    font-weight: 700;
  }

  .outcome-list dd {
    margin: var(--space-xs) 0 0;
  }

  .programme-cta {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .programme-cta h2 {
    color: var(--color-paper);
    font-size: clamp(var(--text-xl), 3vw, var(--text-3xl));
  }

  .programme-cta p {
    max-width: 55ch;
    margin-block-start: var(--space-sm);
    color: var(--color-paper);
  }

  .programme-cta .button {
    width: fit-content;
    border-color: var(--color-paper);
    color: var(--color-paper);
  }

  @media (min-width: 40rem) {
    .programme-spec {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .programme-spec article:nth-child(odd) {
      padding-inline-end: var(--space-xl);
    }

    .programme-spec article:nth-child(even) {
      padding-inline-start: var(--space-xl);
      border-inline-start: var(--rule-hair) solid var(--color-rule);
    }
  }

  @media (min-width: 60rem) {
    .programme-cta {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
