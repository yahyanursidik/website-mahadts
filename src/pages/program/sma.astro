---
import Layout from '../../layouts/Layout.astro';
import { getSiteSettings } from '../../lib/site-settings';

const settings = await getSiteSettings();

const outcomes = [
  {
    title: 'Hafalan 10 juz',
    text: 'Hafalan dibangun secara mutqin—kuat, lancar, dan disertai upaya memahami makna ayat.',
  },
  {
    title: 'Bahasa Arab aktif',
    text: 'Muhadatsah, qira’ah, dan kitabah menjadi alat untuk mengakses literatur keislaman secara mandiri.',
  },
  {
    title: 'Ilmu syar’i mendalam',
    text: 'Aqidah, fikih, dan sirah dipelajari sebagai bekal bersikap dan beribadah dalam kehidupan nyata.',
  },
];

const graduateProfile = [
  'Siap melanjutkan studi dengan bekal akademik dan hafalan Al-Qur’an.',
  'Mampu memahami dasar agama dan teks syar’i secara lebih mandiri.',
  'Menunjukkan adab, kemandirian, dan tanggung jawab kepada diri serta umat.',
];
---

<Layout title="Program SMA Tahfizh - MTQ Tarbiyah Sunnah">
  <main>
    <section class="page-shell split-hero program-hero">
      <div class="split-hero__copy">
        <p class="eyebrow">Pendidikan menengah atas</p>
        <h1>SMA Tahfizh</h1>
        <p class="lede">
          Membentuk pemuda Qur’ani yang matang dalam ilmu, fasih berbahasa Arab,
          dan siap menjadi teladan di tengah masyarakat.
        </p>
        <div class="button-row">
          <a class="button button--primary" href={settings.header.spmbUrl}>Daftar SPMB</a>
          {settings.header.brochureUrl && (
            <a
              class="button button--secondary"
              href={settings.header.brochureUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Unduh brosur
            </a>
          )}
        </div>
      </div>
      <figure class="split-hero__media">
        <img
          src={settings.pages.smaHeroUrl}
          alt="Kegiatan belajar santri SMA Tahfizh"
          width="960"
          height="1120"
          fetchpriority="high"
        />
        <figcaption>
          <span>Fokus program</span>
          <strong>Ilmu, adab, dan kesiapan berdakwah</strong>
        </figcaption>
      </figure>
    </section>

    <section class="page-section page-shell" aria-labelledby="target-title">
      <header class="section-heading">
        <p class="eyebrow">Target utama</p>
        <h2 id="target-title">Tiga bekal yang bertumbuh bersama</h2>
        <p>
          Kurikulum dirancang agar hafalan, bahasa, dan pemahaman agama tidak
          berjalan sendiri-sendiri.
        </p>
      </header>
      <ol class="curriculum-list">
        {outcomes.map((item, index) => (
          <li>
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="page-section page-section--tint">
      <div class="page-shell media-split media-split--reverse">
        <div class="media-split__visual">
          <img
            src={settings.pages.smaHeroUrl}
            alt="Santri SMA mengikuti pembinaan di Ma’had"
            width="960"
            height="720"
            loading="lazy"
          />
        </div>
        <div class="media-split__copy">
          <p class="eyebrow">Program unggulan</p>
          <h2>Kaderisasi imam dan khatib</h2>
          <p>
            Santri dilatih menyampaikan kebaikan dengan hikmah dan hadir
            sebagai pribadi yang bermanfaat bagi lingkungannya.
          </p>
          <ul class="check-list">
            <li>Keberanian dan retorika dakwah yang santun.</li>
            <li>Penguasaan fikih ibadah praktis kemasyarakatan.</li>
            <li>Praktik menjadi imam rawatib dan khatib Jumat.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="page-section page-shell" aria-labelledby="graduate-title">
      <div class="outcome-layout">
        <header>
          <p class="eyebrow">Profil lulusan</p>
          <h2 id="graduate-title">Siap melanjutkan perjalanan</h2>
        </header>
        <ol class="graduate-list">
          {graduateProfile.map((item, index) => (
            <li>
              <span>{index + 1}</span>
              <p>{item}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="page-section page-section--dark">
      <div class="page-shell cta-band">
        <div>
          <p class="eyebrow">Langkah berikutnya</p>
          <h2>Kenali proses penerimaan santri baru.</h2>
        </div>
        <a class="button button--light" href={settings.header.spmbUrl}>Lihat alur SPMB</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* hallmark: scope=program-sma | critique=P5 H4 E4 S5 R5 V4 */
  .curriculum-list,
  .graduate-list,
  .check-list { list-style: none; margin: 0; padding: 0; }
  .curriculum-list { border-top: 1px solid var(--color-rule); }
  .curriculum-list li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-rule);
  }
  .curriculum-list li > span {
    color: var(--color-accent);
    font: 700 var(--text-sm)/1 var(--font-body);
  }
  .curriculum-list h3 { margin: 0 0 var(--space-2); }
  .curriculum-list p { max-width: 42rem; margin: 0; color: var(--color-ink-2); }
  .check-list { display: grid; gap: var(--space-3); margin-top: var(--space-6); }
  .check-list li {
    padding-left: var(--space-6);
    position: relative;
    color: var(--color-ink);
  }
  .check-list li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }
  .outcome-layout {
    display: grid;
    grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }
  .graduate-list { border-top: 1px solid var(--color-rule); }
  .graduate-list li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-rule);
  }
  .graduate-list span { color: var(--color-accent); font-weight: 700; }
  .graduate-list p { margin: 0; }
  @media (max-width: 48rem) {
    .outcome-layout { grid-template-columns: 1fr; gap: var(--space-7); }
  }
</style>
