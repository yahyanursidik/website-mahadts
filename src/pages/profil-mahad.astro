---
import Layout from '../layouts/Layout.astro';
import pengaturanHalaman from '../content/pengaturanHalaman/data.json';

const missions = {
  smp: [
    'Menanamkan akidah Ahlussunnah wal Jamaah serta membimbing adab dan akhlak Islami.',
    'Membimbing santri menghafal Al-Qur’an dengan target 20 juz.',
    'Memperkenalkan keterampilan bahasa Arab dan dasar-dasar ilmu syar’i.',
    'Memberikan pengetahuan umum serta membina disiplin dan tanggung jawab di asrama.',
  ],
  sma: [
    'Menguatkan akidah, adab, akhlak Islami, dan pemahaman ilmu syar’i.',
    'Membimbing santri menghafal Al-Qur’an dengan target tambahan 10 juz.',
    'Meningkatkan kemampuan bahasa Arab serta kesiapan menjadi imam dan khatib.',
    'Membina kedewasaan, kemandirian, dan kesiapan studi ke jenjang berikutnya.',
  ],
};

const leadership = [
  ['Ustadz Abu Haidar As-Sundawy', 'Pembina'],
  ['Ustadz Mochammad Hilman Al Fiqhy, M.A.', 'Ketua Bidang Pendidikan'],
  ['Ustadz Haidar Askarulqohar, Lc.', 'Mudir'],
];
---

<Layout title="Profil Ma’had - MTQ Tarbiyah Sunnah">
  <main>
    <section class="split-hero split-hero--reverse">
      <div class="split-hero__copy">
        <h1>Berakar pada Sunnah, tumbuh melalui ilmu.</h1>
        <p class="split-hero__lede">
          MTQ Tarbiyah Sunnah memadukan tradisi keilmuan Islam, tahfizh
          Al-Qur’an, pendidikan formal, dan pembinaan kehidupan berasrama.
        </p>
        <div class="split-hero__actions">
          <a class="button button--primary" href="/program/smp">Lihat program</a>
          <a class="editorial-link" href="#sejarah">Baca perjalanan Ma’had <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <figure class="split-hero__media">
        <img
          src={pengaturanHalaman.heroProfil}
          alt="Lingkungan Ma’had Tahfizhul Qur’an Tarbiyah Sunnah"
          width="1600"
          height="1200"
          fetchpriority="high"
        />
      </figure>
    </section>

    <nav class="profile-index page-shell" aria-label="Daftar isi profil">
      <a href="#sejarah">Sejarah</a>
      <a href="#visi-misi">Visi dan misi</a>
      <a href="#struktur">Kepengurusan</a>
    </nav>

    <section class="page-section" id="sejarah">
      <div class="page-shell media-split">
        <figure class="media-split__figure">
          <img
            src={pengaturanHalaman.gambarSejarahProfil}
            alt="Kegiatan pendidikan dalam perjalanan MTQ Tarbiyah Sunnah"
            width="1200"
            height="900"
            loading="lazy"
          />
        </figure>
        <div class="media-split__copy">
          <h2>Dari kaderisasi da’i menuju pendidikan berjenjang.</h2>
          <p>
            Di bawah naungan Yayasan Tarbiyah Sunnah Bandung, Ma’had hadir
            untuk menghidupkan pendidikan Al-Qur’an melalui tahfizh, tajwid,
            talaqqi, dan pembinaan adab terhadap kalamullah.
          </p>
          <p>
            Ma’had ini berkembang dari Tadribut Du’at, program kaderisasi yang
            menyiapkan para da’i dengan hafalan Al-Qur’an, dasar ilmu syar’i,
            bahasa Arab, adab, dan kesiapan berdakwah.
          </p>
          <p>
            Semangat tersebut kini diteruskan dalam pendidikan SMP dan SMA
            khusus putra, lengkap dengan pendidikan umum dan kehidupan asrama.
          </p>
        </div>
      </div>
    </section>

    <section class="page-section page-section--paper-2" id="visi-misi">
      <div class="page-shell">
        <div class="vision-copy">
          <h2>Visi yang menjaga arah.</h2>
          <p>
            “Menjadi lembaga pendidikan Islam yang unggul dalam mencetak
            penghafal Al-Qur’an yang berakidah Ahlussunnah wal Jamaah,
            berakhlak mulia, mampu berbahasa Arab, berilmu, dan mandiri.”
          </p>
        </div>
        <div class="mission-columns">
          <article>
            <h3>Misi Program SMP</h3>
            <ul>
              {missions.smp.map((mission) => <li>{mission}</li>)}
            </ul>
          </article>
          <article>
            <h3>Misi Program SMA</h3>
            <ul>
              {missions.sma.map((mission) => <li>{mission}</li>)}
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="page-section" id="struktur">
      <div class="page-shell leadership">
        <div class="section-heading">
          <h2>Kepengurusan Ma’had</h2>
          <p>Asatidzah dan pengurus yang menjaga arah pendidikan serta pembinaan santri.</p>
        </div>
        <div class="leadership__list">
          {leadership.map(([name, role]) => (
            <article>
              <h3>{name}</h3>
              <p>{role}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Hallmark · genre: editorial · macrostructure: Split Studio · design-system: design.md · designed-as-app */
  .profile-index {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    padding-block: var(--space-lg);
    border-block: var(--rule-hair) solid var(--color-rule);
  }

  .profile-index a {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 700;
    text-underline-offset: var(--space-2xs);
    white-space: nowrap;
  }

  .vision-copy {
    display: grid;
    gap: var(--space-lg);
    margin-block-end: var(--space-2xl);
  }

  .vision-copy h2 {
    font-size: clamp(var(--text-xl), 3vw, var(--text-3xl));
  }

  .vision-copy p {
    max-width: 62ch;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(var(--text-lg), 2.5vw, var(--text-2xl));
    line-height: 1.5;
  }

  .mission-columns {
    display: grid;
    gap: var(--space-xl);
  }

  .mission-columns article {
    padding-block-start: var(--space-lg);
    border-block-start: var(--rule-hair) solid var(--color-rule-strong);
  }

  .mission-columns h3 {
    margin-block-end: var(--space-lg);
    font-family: var(--font-body);
    font-size: var(--text-lg);
  }

  .mission-columns ul {
    margin: 0;
    padding-inline-start: var(--space-lg);
    display: grid;
    gap: var(--space-md);
    color: var(--color-ink-2);
  }

  .leadership__list {
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .leadership__list article {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-lg);
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  .leadership__list h3 {
    font-family: var(--font-body);
    font-size: var(--text-md);
  }

  .leadership__list p {
    color: var(--color-accent-warm-deep);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  @media (min-width: 60rem) {
    .vision-copy {
      grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
      align-items: start;
    }

    .mission-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3xl);
    }

    .leadership {
      display: grid;
      grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.35fr);
      gap: var(--space-3xl);
      align-items: start;
    }

    .leadership__list article {
      grid-template-columns: minmax(0, 1.4fr) minmax(10rem, 0.6fr);
      align-items: baseline;
    }
  }
</style>
