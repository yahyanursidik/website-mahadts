---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getSiteSettings } from '../lib/site-settings';
import { pairs } from '../lib/content-format';

const settings = await getSiteSettings();
const content = settings.content.spmb;
const steps = pairs(content.steps);
---

<Layout title="SPMB - MTQ Tarbiyah Sunnah">
  <main>
    <section class="page-shell split-hero spmb-hero">
      <div class="split-hero__copy">
        <p class="eyebrow">{content.eyebrow}</p>
        <h1>{content.heroTitle}</h1>
        <p class="lede">
          {content.heroLede}
        </p>
        <div class="button-row">
          <a class="button button--primary" href="#alur-pendaftaran">Lihat alur</a>
          {settings.header.brochureUrl ? (
            <a
              class="button button--secondary"
              href={settings.header.brochureUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Buka brosur
            </a>
          ) : (
            <a
              class="button button--secondary"
              href={settings.footer.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Konsultasi admin
            </a>
          )}
        </div>
      </div>
      <figure class="split-hero__media">
        <img
          src={settings.pages.spmbHeroUrl}
          alt="Santri Ma’had Tarbiyah Sunnah sedang belajar"
          width="960"
          height="1120"
          fetchpriority="high"
        />
        <figcaption>
          <span>Status</span>
          <strong>{content.statusText}</strong>
        </figcaption>
      </figure>
    </section>

    <section class="page-section page-section--tint" id="alur-pendaftaran" aria-labelledby="flow-title">
      <div class="page-shell">
        <header class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Alur pendaftaran</p>
            <h2 id="flow-title">{content.flowTitle}</h2>
          </div>
          <p>
            {content.flowLede}
          </p>
        </header>
        <ol class="registration-flow">
          {steps.map(([title, text], index) => (
            <li>
              <span class="registration-flow__number">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="page-section">
      <div class="page-shell inquiry-block">
        <div>
          <p class="eyebrow">{content.helpEyebrow}</p>
          <h2>{content.helpTitle}</h2>
          <p>{content.helpText}</p>
        </div>
        <a
          class="button button--primary"
          href={settings.footer.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Hubungi admin
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* hallmark: scope=spmb | critique=P5 H4 E4 S5 R5 V4 */
  .registration-flow { list-style: none; padding: 0; margin: var(--space-8) 0 0; }
  .registration-flow li {
    display: grid;
    grid-template-columns: minmax(3rem, 8rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--color-rule);
  }
  .registration-flow li:last-child { border-bottom: 1px solid var(--color-rule); }
  .registration-flow__number {
    color: var(--color-accent);
    font: 700 var(--text-sm)/1 var(--font-body);
    letter-spacing: .12em;
  }
  .registration-flow h3 { margin: 0 0 var(--space-2); }
  .registration-flow p { max-width: 46rem; margin: 0; color: var(--color-ink-2); }
  .inquiry-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-8);
    align-items: end;
  }
  .inquiry-block h2 { max-width: 16ch; }
  .inquiry-block p:not(.eyebrow) {
    max-width: 42rem;
    margin: var(--space-4) 0 0;
    color: var(--color-ink-2);
  }
  @media (max-width: 40rem) {
    .registration-flow li { grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--space-4); }
    .inquiry-block { grid-template-columns: 1fr; align-items: start; }
    .inquiry-block .button { width: 100%; }
  }
</style>
