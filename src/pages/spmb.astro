---
import Layout from '../layouts/Layout.astro';
import pengaturanHalaman from '../content/pengaturanHalaman/data.json';
import pengaturanUtama from '../content/pengaturanUtama/data.json';
import { directusAssetUrl, getPageSettings, getSiteSettings } from '../lib/directus';

const [pageSettings, siteSettings] = await Promise.all([
  getPageSettings('spmb'),
  getSiteSettings(),
]);
const heroImage = directusAssetUrl(pageSettings?.hero_image) || pengaturanHalaman.heroSpmb;
const heroEyebrow = pageSettings?.hero_eyebrow || 'Penerimaan murid baru';
const heroTitle = pageSettings?.hero_title || 'Satu alur yang jelas untuk memulai.';
const heroDescription = pageSettings?.hero_description || 'Kenali tahapan pendaftaran Ma’had Tahfizhul Qur’an Tarbiyah Sunnah, lalu konsultasikan kebutuhan calon santri bersama admin.';
const brochureUrl = siteSettings?.brochure_url || pengaturanUtama.linkBrosur;

const steps = [
  ['Informasi', 'Pelajari brosur, pilihan program, dan persyaratan pendaftaran.'],
  ['Formulir online', 'Lengkapi data calon santri melalui formulir resmi.'],
  ['Berkas', 'Siapkan dan unggah dokumen persyaratan yang diminta.'],
  ['Seleksi', 'Ikuti tes akademik serta tes kepesantrenan sesuai jadwal.'],
  ['Wawancara', 'Calon santri dan orang tua mengikuti sesi wawancara.'],
  ['Pengumuman', 'Hasil seleksi disampaikan melalui kanal resmi Ma’had.'],
  ['Daftar ulang', 'Selesaikan administrasi untuk mengamankan tempat belajar.'],
];
---

<Layout title="SPMB - MTQ Tarbiyah Sunnah">
  <main>
    <section class="page-shell split-hero spmb-hero">
      <div class="split-hero__copy">
        <p class="eyebrow">{heroEyebrow}</p>
        <h1>{heroTitle}</h1>
        <p class="lede">
          {heroDescription}
        </p>
        <div class="button-row">
          <a class="button button--primary" href="#alur-pendaftaran">Lihat alur</a>
          {brochureUrl ? (
            <a
              class="button button--secondary"
              href={brochureUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Buka brosur
            </a>
          ) : (
            <a
              class="button button--secondary"
              href="https://wa.me/6281210001476"
              target="_blank"
              rel="noopener noreferrer"
            >
              Konsultasi admin
            </a>
          )}
        </div>
      </div>
      <figure class="split-hero__media">
        <img
          src={heroImage}
          alt="Santri Ma’had Tarbiyah Sunnah sedang belajar"
          width="960"
          height="1120"
          fetchpriority="high"
        />
        <figcaption>
          <span>Status</span>
          <strong>Informasi pendaftaran tersedia</strong>
        </figcaption>
      </figure>
    </section>

    <section class="page-section page-section--tint" id="alur-pendaftaran" aria-labelledby="flow-title">
      <div class="page-shell">
        <header class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Alur pendaftaran</p>
            <h2 id="flow-title">Tujuh tahap, dari informasi hingga daftar ulang.</h2>
          </div>
          <p>
            Urutan ini membantu keluarga menyiapkan setiap tahap tanpa melewatkan
            dokumen atau agenda penting.
          </p>
        </header>
        <ol class="registration-flow">
          {steps.map(([title, text], index) => (
            <li>
              <span class="registration-flow__number">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="page-section">
      <div class="page-shell inquiry-block">
        <div>
          <p class="eyebrow">Butuh bantuan?</p>
          <h2>Pastikan informasi sebelum mengirim berkas.</h2>
          <p>
            Admin siap membantu menjelaskan persyaratan, program, serta jadwal
            yang berlaku.
          </p>
        </div>
        <a
          class="button button--primary"
          href="https://wa.me/6281210001476?text=Bismillah%2C%20saya%20ingin%20bertanya%20tentang%20SPMB."
          target="_blank"
          rel="noopener noreferrer"
        >
          Hubungi admin
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* hallmark: scope=spmb | critique=P5 H4 E4 S5 R5 V4 */
  .registration-flow { list-style: none; padding: 0; margin: var(--space-8) 0 0; }
  .registration-flow li {
    display: grid;
    grid-template-columns: minmax(3rem, 8rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--color-rule);
  }
  .registration-flow li:last-child { border-bottom: 1px solid var(--color-rule); }
  .registration-flow__number {
    color: var(--color-accent);
    font: 700 var(--text-sm)/1 var(--font-body);
    letter-spacing: .12em;
  }
  .registration-flow h3 { margin: 0 0 var(--space-2); }
  .registration-flow p { max-width: 46rem; margin: 0; color: var(--color-ink-2); }
  .inquiry-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-8);
    align-items: end;
  }
  .inquiry-block h2 { max-width: 16ch; }
  .inquiry-block p:not(.eyebrow) {
    max-width: 42rem;
    margin: var(--space-4) 0 0;
    color: var(--color-ink-2);
  }
  @media (max-width: 40rem) {
    .registration-flow li { grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--space-4); }
    .inquiry-block { grid-template-columns: 1fr; align-items: start; }
    .inquiry-block .button { width: 100%; }
  }
</style>
