---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getSiteSettings } from '../lib/site-settings';

const settings = await getSiteSettings();
const heroImage = settings.hero.posterUrl;
const programmes = [
  {
    title: 'SMP Tahfizh',
    target: 'Target hafalan 20 juz',
    href: '/program/smp',
    image: '/images/program/smp-tahfizh.jpeg',
    description: 'Tahfizh Al-Qur’an, ilmu diniyah, bahasa Arab, dan kurikulum nasional untuk santri putra tingkat menengah pertama.',
  },
  {
    title: 'SMA Tahfizh',
    target: 'Target hafalan tambahan 10 juz',
    href: '/program/sma',
    image: '/images/program/sma-tahfizh.jpeg',
    description: 'Pendalaman ilmu syar’i, bahasa Arab aktif, akademik formal, dan pembinaan kemandirian untuk studi lanjut.',
  },
];
---

<Layout title="Beranda - MTQ Tarbiyah Sunnah">
  <main>
    <section class="home-hero">
      <div class="home-hero__media" aria-hidden="true">
        <img
          class="home-hero__poster"
          src={heroImage}
          alt=""
          width="1600"
          height="1200"
          fetchpriority="high"
        />
        <video class="home-hero__video" muted loop playsinline preload="none" aria-hidden="true">
          <source data-src={settings.hero.videoUrl} type="video/mp4" />
        </video>
      </div>
      <div class="home-hero__overlay" aria-hidden="true"></div>
      <div class="page-shell home-hero__content">
        <h1>{settings.hero.headline}</h1>
        <p class="home-hero__lede">
          {settings.hero.lede}
        </p>
        <div class="home-hero__actions">
          <a class="button button--primary" href={settings.header.spmbUrl}>{settings.hero.primaryLabel}</a>
          <a
            class="button button--secondary"
            href={settings.header.brochureUrl || settings.header.spmbUrl}
            target={settings.header.brochureUrl ? '_blank' : undefined}
            rel={settings.header.brochureUrl ? 'noopener noreferrer' : undefined}
          >
            {settings.hero.secondaryLabel}
          </a>
          <a class="editorial-link" href={settings.hero.contactUrl} target="_blank" rel="noopener noreferrer">
            {settings.hero.contactLabel} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="page-section--paper-2">
      <div class="page-shell info-rail" aria-label="Ringkasan program">
        <div>
          <strong>SMP dan SMA khusus putra</strong>
          <p>Tahfizh, diniyah, bahasa Arab, dan akademik formal.</p>
        </div>
        <div>
          <strong>Ijazah resmi negara</strong>
          <p>Pendidikan berasrama dengan pembinaan adab dan kemandirian.</p>
        </div>
      </div>
    </section>

    <section class="spmb-notice" aria-labelledby="spmb-title">
      <div class="page-shell">
        <div class="spmb-notice__heading">
          <div>
            <p class="eyebrow">Penerimaan murid baru</p>
            <h2 id="spmb-title">SPMB 2027/2028</h2>
          </div>
          <p>Informasi penting untuk keluarga yang sedang menyiapkan pendidikan SMP atau SMA Tahfizh putra.</p>
        </div>

        <div class="spmb-notice__layout">
          <figure class="spmb-notice__poster">
            <img src="/images/spmb/spmb-2027-2028.jpeg" alt="Poster Sistem Penerimaan Murid Baru Ma’had Tahfizhul Qur’an Tarbiyah Sunnah tahun ajaran 2027/2028" width="600" height="1600" loading="lazy" />
            <figcaption>Informasi lengkap SPMB Ma’had Tahfizhul Qur’an Tarbiyah Sunnah.</figcaption>
          </figure>

          <div class="spmb-notice__content">
            <div class="spmb-notice__signal"><span aria-hidden="true"></span> Pendaftaran sedang dibuka</div>
            <h3>Mulai dengan informasi yang jelas.</h3>
            <p class="spmb-notice__lede">Kuota terbatas untuk santri putra jenjang SMP dan SMA, dengan program Tahfizh hingga 30 juz.</p>

            <dl class="spmb-notice__facts">
              <div><dt>Jenjang</dt><dd>SMP &amp; SMA putra</dd></div>
              <div><dt>Program</dt><dd>Tahfizh Al-Qur’an 30 juz</dd></div>
              <div><dt>Pendaftaran</dt><dd>01 Sep — 20 Okt 2026</dd></div>
              <div><dt>Hasil seleksi</dt><dd>27 Okt 2026</dd></div>
            </dl>

            <div class="spmb-notice__costs" aria-label="Ringkasan biaya">
              <p>Ringkasan biaya</p>
              <dl>
                <div><dt>Pendaftaran</dt><dd>Rp500.000</dd></div>
                <div><dt>SPP per bulan</dt><dd>Rp1.650.000</dd></div>
                <div><dt>Uang masuk</dt><dd>Rp21.500.000</dd></div>
                <div><dt>Daftar ulang</dt><dd>Rp2.000.000</dd></div>
              </dl>
              <small>Uang masuk mencakup kitab, ekstrakurikuler, riblah, dan kegiatan tahunan.</small>
            </div>

            <div class="spmb-notice__actions">
              <a class="button button--primary" href={settings.header.spmbUrl}>Daftar SPMB</a>
              <a class="button button--secondary" href={settings.header.brochureUrl || settings.header.spmbUrl} target={settings.header.brochureUrl ? '_blank' : undefined} rel={settings.header.brochureUrl ? 'noopener noreferrer' : undefined}>Lihat brosur</a>
            </div>
            <p class="spmb-notice__help">Butuh bantuan pendaftaran? <a href="tel:+6281210001476">0812-1000-1476</a></p>
          </div>
        </div>
      </div>
    </section>

    <section class="profile-video" aria-labelledby="profile-video-title">
      <div class="page-shell profile-video__layout">
        <div class="profile-video__copy">
          <p class="eyebrow">Mengenal Ma’had</p>
          <h2 id="profile-video-title">Lihat keseharian santri di Ma’had.</h2>
          <p>Kenali suasana belajar, pembinaan, dan lingkungan pendidikan Ma’had Tahfizhul Qur’an Tarbiyah Sunnah melalui tayangan singkat ini.</p>
          <a class="editorial-link" href="https://youtu.be/fvYwyIZ7KV4" target="_blank" rel="noopener noreferrer">
            Tonton di YouTube <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="profile-video__frame">
          <iframe
            src="https://www.youtube-nocookie.com/embed/fvYwyIZ7KV4"
            title="Video profil Ma’had Tahfizhul Qur’an Tarbiyah Sunnah"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="page-shell">
        <div class="section-heading">
          <h2>Dua jenjang, satu arah pendidikan.</h2>
          <p>
            Setiap jenjang disusun untuk menjaga kesinambungan hafalan,
            pemahaman agama, kemampuan akademik, dan kesiapan hidup mandiri.
          </p>
        </div>
        <div class="program-list">
          {programmes.map((programme, index) => (
            <article class={`media-split ${index % 2 ? 'media-split--reverse' : ''}`}>
              <figure class="media-split__figure">
                <img
                  src={programme.image}
                  alt={`Kegiatan ${programme.title}`}
                  width="1200"
                  height="900"
                  loading="lazy"
                />
              </figure>
              <div class="media-split__copy">
                <h3>{programme.title}</h3>
                <strong>{programme.target}</strong>
                <p>{programme.description}</p>
                <a class="editorial-link" href={programme.href}>
                  Lihat program <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="page-section page-section--ink">
      <div class="page-shell vision-statement">
        <h2>Visi Ma’had</h2>
        <p>
          “Menjadi lembaga pendidikan Islam yang unggul dalam mencetak
          penghafal Al-Qur’an yang berakidah Ahlussunnah wal Jamaah, berakhlak
          mulia, mampu berbahasa Arab, berilmu, dan mandiri.”
        </p>
        <a class="button button--secondary" href="/profil-mahad">Baca profil Ma’had</a>
      </div>
    </section>
  </main>
</Layout>

<script>
  const video = document.querySelector<HTMLVideoElement>('.home-hero__video');
  const source = video?.querySelector<HTMLSourceElement>('source[data-src]');
  const connection = navigator.connection as (NetworkInformation & { saveData?: boolean }) | undefined;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const startVideo = () => {
    if (!video || !source || reduceMotion || connection?.saveData) return;
    source.src = source.dataset.src ?? '';
    video.addEventListener('canplay', () => {
      video.classList.add('is-ready');
      void video.play().catch(() => undefined);
    }, { once: true });
    video.load();
  };

  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(startVideo, { timeout: 2500 });
  } else {
    window.setTimeout(startVideo, 1200);
  }
</script>

<style>
  /* Hallmark · genre: editorial · macrostructure: Split Studio · theme: Garden
   * enrichment: E2 full-bleed decorative video + E8 supplied SPMB poster · poster fallback · reduced-motion static image
   * nav: N12 Announcement Banner + Retracting Nav · footer: Ft1 Mast-headed
   * audience: calon wali santri · use: memahami SPMB lalu mendaftar · tone: editorial-hangat
   * design-system: design.md · pre-emit critique: P5 H5 E5 S5 R5 V5
   * contrast: pass (40–41) · slop: pass (5, 8, 10–57) · responsive: pass (34, 49, 50–57)
   */
  .home-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: clamp(38rem, 74dvh, 48rem);
    overflow: clip;
    background: var(--color-ink);
  }

  .home-hero__media,
  .home-hero__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .home-hero__media {
    z-index: -2;
  }

  .home-hero__poster,
  .home-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero__poster {
    display: block;
  }

  .home-hero__video {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }

  .home-hero__video.is-ready { visibility: visible; }

  .home-hero__overlay {
    z-index: -1;
    background: var(--color-hero-overlay);
  }

  .home-hero__content {
    align-self: center;
    display: grid;
    gap: var(--space-lg);
    min-width: 0;
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .home-hero h1 {
    max-width: 13ch;
    color: var(--color-paper);
    font-size: var(--text-display-s);
    line-height: 1.06;
    overflow-wrap: anywhere;
  }

  .home-hero__lede {
    max-width: 58ch;
    margin: 0;
    color: var(--color-paper);
    font-size: var(--text-md);
    line-height: 1.55;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .home-hero .button--secondary {
    border-color: var(--color-paper);
    color: var(--color-paper);
  }

  .home-hero .editorial-link {
    color: var(--color-paper);
  }

  @media (hover: hover) and (pointer: fine) {
    .home-hero .button--secondary:hover {
      background: var(--color-paper);
      color: var(--color-accent-deep);
    }

    .home-hero .editorial-link:hover {
      color: var(--color-accent-soft);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__video {
      display: none;
    }
  }

  .spmb-notice {
    background: var(--color-paper);
    padding-block: var(--space-4xl);
  }

  .spmb-notice__heading {
    align-items: end;
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    margin-bottom: var(--space-2xl);
  }

  .spmb-notice__heading h2 {
    color: var(--color-ink);
    font-size: var(--text-3xl);
    line-height: 1.12;
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .spmb-notice__heading > p {
    color: var(--color-ink-2);
    line-height: 1.6;
    margin: 0;
    max-width: 45ch;
  }

  .spmb-notice__layout {
    align-items: stretch;
    display: grid;
    gap: clamp(var(--space-xl), 6vw, var(--space-4xl));
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
  }

  .spmb-notice__poster {
    align-self: start;
    margin: 0;
  }

  .spmb-notice__poster img {
    aspect-ratio: 3 / 8;
    border: var(--rule-hair) solid var(--color-rule-strong);
    display: block;
    height: auto;
    max-height: 46rem;
    object-fit: cover;
    width: 100%;
  }

  .spmb-notice__poster figcaption {
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.5;
    margin-top: var(--space-sm);
  }

  .spmb-notice__content {
    align-content: start;
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
  }

  .spmb-notice__signal {
    align-items: center;
    color: var(--color-accent-deep);
    display: inline-flex;
    font-size: var(--text-sm);
    font-weight: 700;
    gap: var(--space-xs);
    width: fit-content;
  }

  .spmb-notice__signal span {
    background: var(--color-success);
    border-radius: var(--radius-pill);
    height: var(--space-xs);
    width: var(--space-xs);
  }

  .spmb-notice__content h3 {
    font-size: clamp(var(--text-xl), 3vw, var(--text-3xl));
    line-height: 1.14;
    margin: 0;
    max-width: 16ch;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .spmb-notice__lede {
    color: var(--color-ink-2);
    line-height: 1.65;
    margin: 0;
    max-width: 58ch;
  }

  .spmb-notice__facts,
  .spmb-notice__costs dl {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .spmb-notice__facts {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .spmb-notice__facts div,
  .spmb-notice__costs dl div {
    border-top: var(--rule-hair) solid var(--color-rule);
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-md) var(--space-sm) var(--space-md) 0;
  }

  .spmb-notice__facts div:nth-child(odd) {
    padding-right: var(--space-lg);
  }

  .spmb-notice__facts dt,
  .spmb-notice__costs dt {
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .spmb-notice__facts dd,
  .spmb-notice__costs dd {
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 700;
    margin: 0;
  }

  .spmb-notice__costs {
    background: var(--color-accent-soft);
    border-block-start: var(--rule-hair) solid var(--color-accent-warm-deep);
    padding: var(--space-lg);
  }

  .spmb-notice__costs > p {
    color: var(--color-accent-deep);
    font-size: var(--text-sm);
    font-weight: 700;
    margin: 0 0 var(--space-sm);
  }

  .spmb-notice__costs dl {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .spmb-notice__costs dl div:nth-child(odd) {
    padding-right: var(--space-md);
  }

  .spmb-notice__costs small {
    color: var(--color-ink-2);
    display: block;
    font-size: var(--text-xs);
    line-height: 1.55;
    margin-top: var(--space-sm);
  }

  .spmb-notice__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .spmb-notice__help {
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    margin: 0;
  }

  .spmb-notice__help a {
    color: var(--color-accent-deep);
    font-weight: 700;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
  }

  .profile-video {
    background: var(--color-paper-2);
    border-block: var(--rule-hair) solid var(--color-rule);
    padding-block: var(--space-4xl);
  }

  .profile-video__layout {
    align-items: center;
    display: grid;
    gap: clamp(var(--space-xl), 6vw, var(--space-4xl));
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
  }

  .profile-video__copy {
    display: grid;
    gap: var(--space-lg);
    min-width: 0;
  }

  .profile-video__copy h2 {
    font-size: clamp(var(--text-xl), 3.5vw, var(--text-3xl));
    line-height: 1.14;
    max-width: 15ch;
  }

  .profile-video__copy > p:not(.eyebrow) {
    color: var(--color-ink-2);
    line-height: 1.65;
    margin: 0;
    max-width: 52ch;
  }

  .profile-video__copy .editorial-link {
    color: var(--color-accent-deep);
    font-weight: 700;
    width: fit-content;
  }

  .profile-video__frame {
    aspect-ratio: 16 / 9;
    background: var(--color-ink);
    border: var(--rule-hair) solid var(--color-rule-strong);
    min-width: 0;
  }

  .profile-video__frame iframe {
    border: 0;
    display: block;
    height: 100%;
    width: 100%;
  }

  .program-list {
    display: grid;
    gap: var(--space-3xl);
  }

  .media-split__copy > strong {
    color: var(--color-accent-warm-deep);
    font-size: var(--text-sm);
  }

  .vision-statement {
    display: grid;
    gap: var(--space-xl);
  }

  .vision-statement h2 {
    max-width: 10ch;
    color: var(--color-paper);
    font-size: clamp(var(--text-xl), 4vw, var(--text-3xl));
  }

  .vision-statement p {
    max-width: 62ch;
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: clamp(var(--text-lg), 3vw, var(--text-2xl));
    line-height: 1.5;
  }

  .vision-statement .button {
    width: fit-content;
    border-color: var(--color-paper);
    color: var(--color-paper);
  }

  @media (min-width: 60rem) {
    .vision-statement {
      grid-template-columns: minmax(0, 0.45fr) minmax(0, 1.25fr);
      align-items: start;
    }

    .vision-statement .button {
      grid-column: 2;
    }
  }

  @media (max-width: 59.99rem) {
    .spmb-notice__heading,
    .spmb-notice__layout,
    .profile-video__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .spmb-notice__heading > p {
      max-width: 58ch;
    }

    .spmb-notice__poster {
      max-width: 27rem;
    }

    .profile-video__copy h2 {
      max-width: 22ch;
    }
  }

  @media (max-width: 40rem) {
    .spmb-notice {
      padding-block: var(--space-3xl);
    }

    .profile-video {
      padding-block: var(--space-3xl);
    }

    .spmb-notice__facts,
    .spmb-notice__costs dl {
      grid-template-columns: minmax(0, 1fr);
    }

    .spmb-notice__facts div:nth-child(odd),
    .spmb-notice__costs dl div:nth-child(odd) {
      padding-right: 0;
    }

    .spmb-notice__actions .button {
      width: 100%;
    }
  }
</style>
