---
import Layout from '../layouts/Layout.astro';
import pengaturanBeranda from '../content/pengaturanBeranda/data.json';
import pengaturanUtama from '../content/pengaturanUtama/data.json';
import { directusAssetUrl, getPageSettings, getSiteSettings } from '../lib/directus';

const slideshowImages = pengaturanBeranda.slideshow || [];
const [pageSettings, siteSettings] = await Promise.all([
  getPageSettings('beranda'),
  getSiteSettings(),
]);
const heroImage = directusAssetUrl(pageSettings?.hero_image) || slideshowImages[0] || '/images/hero/heroSmp.webp';
const heroVideo = directusAssetUrl(pageSettings?.hero_video) || '/videos/classroom-school.mp4';
const heroTitle = pageSettings?.hero_title || 'Mendidik generasi Qur’ani yang teguh dan mandiri.';
const heroDescription = pageSettings?.hero_description || 'Pendidikan SMP dan SMA khusus putra yang memadukan tahfizh Al-Qur’an, ilmu diniyah, bahasa Arab, akademik formal, dan pembinaan adab dalam lingkungan asrama.';
const spmbUrl = siteSettings?.spmb_url || pengaturanUtama.linkSpmb || 'https://hub.mahadtarbiyahsunnah.com/login/spmb';
const brochureUrl = siteSettings?.brochure_url || pengaturanUtama.linkBrosur;
const primaryCtaLabel = pageSettings?.primary_cta_label || 'Daftar SPMB';
const primaryCtaUrl = pageSettings?.primary_cta_url || spmbUrl;
const secondaryCtaLabel = pageSettings?.secondary_cta_label || 'Lihat brosur';
const secondaryCtaUrl = pageSettings?.secondary_cta_url || brochureUrl || spmbUrl;
const heroOverlay = pageSettings?.hero_overlay === 'soft' ? 'soft' : 'dark';
const showSummary = pageSettings?.show_summary ?? true;
const showContent = pageSettings?.show_content ?? true;
const showCta = pageSettings?.show_cta ?? true;
const programmes = [
  {
    title: 'SMP Tahfizh',
    target: 'Target hafalan 20 juz',
    href: '/program/smp',
    image: '/images/hero/heroSmp.webp',
    description: 'Tahfizh Al-Qur’an, ilmu diniyah, bahasa Arab, dan kurikulum nasional untuk santri putra tingkat menengah pertama.',
  },
  {
    title: 'SMA Tahfizh',
    target: 'Target hafalan tambahan 10 juz',
    href: '/program/sma',
    image: '/images/hero/heroSma.webp',
    description: 'Pendalaman ilmu syar’i, bahasa Arab aktif, akademik formal, dan pembinaan kemandirian untuk studi lanjut.',
  },
];
---

<Layout title="Beranda - MTQ Tarbiyah Sunnah">
  <main>
    <section class:list={['home-hero', `home-hero--overlay-${heroOverlay}`]}>
      <div class="home-hero__media" aria-hidden="true">
        <img
          class="home-hero__poster"
          src={heroImage}
          alt=""
          width="1600"
          height="1200"
          fetchpriority="high"
        />
        <video class="home-hero__video" autoplay muted loop playsinline preload="metadata" poster={heroImage}>
          <source src={heroVideo} type="video/mp4" />
        </video>
      </div>
      <div class="home-hero__overlay" aria-hidden="true"></div>
      <div class="page-shell home-hero__content">
        <h1>{heroTitle}</h1>
        <p class="home-hero__lede">
          {heroDescription}
        </p>
        <div class="home-hero__actions">
          <a class="button button--primary" href={primaryCtaUrl}>{primaryCtaLabel}</a>
          <a
            class="button button--secondary"
            href={secondaryCtaUrl}
            target={secondaryCtaUrl.startsWith('http') ? '_blank' : undefined}
            rel={secondaryCtaUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {secondaryCtaLabel}
          </a>
          <a class="editorial-link" href="https://wa.me/6281210001476" target="_blank" rel="noopener noreferrer">
            Hubungi admin <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    {showSummary && <section class="page-section--paper-2">
      <div class="page-shell info-rail" aria-label="Ringkasan program">
        <div>
          <strong>SMP dan SMA khusus putra</strong>
          <p>Tahfizh, diniyah, bahasa Arab, dan akademik formal.</p>
        </div>
        <div>
          <strong>Ijazah resmi negara</strong>
          <p>Pendidikan berasrama dengan pembinaan adab dan kemandirian.</p>
        </div>
      </div>
    </section>}

    {showContent && <section class="page-section">
      <div class="page-shell">
        <div class="section-heading">
          <h2>Dua jenjang, satu arah pendidikan.</h2>
          <p>
            Setiap jenjang disusun untuk menjaga kesinambungan hafalan,
            pemahaman agama, kemampuan akademik, dan kesiapan hidup mandiri.
          </p>
        </div>
        <div class="program-list">
          {programmes.map((programme, index) => (
            <article class={`media-split ${index % 2 ? 'media-split--reverse' : ''}`}>
              <figure class="media-split__figure">
                <img
                  src={programme.image}
                  alt={`Kegiatan ${programme.title}`}
                  width="1200"
                  height="900"
                  loading="lazy"
                />
              </figure>
              <div class="media-split__copy">
                <h3>{programme.title}</h3>
                <strong>{programme.target}</strong>
                <p>{programme.description}</p>
                <a class="editorial-link" href={programme.href}>
                  Lihat program <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>}

    {showCta && <section class="page-section page-section--ink">
      <div class="page-shell vision-statement">
        <h2>Visi Ma’had</h2>
        <p>
          “Menjadi lembaga pendidikan Islam yang unggul dalam mencetak
          penghafal Al-Qur’an yang berakidah Ahlussunnah wal Jamaah, berakhlak
          mulia, mampu berbahasa Arab, berilmu, dan mandiri.”
        </p>
        <a class="button button--secondary" href="/profil-mahad">Baca profil Ma’had</a>
      </div>
    </section>}
  </main>
</Layout>

<style>
  /* Hallmark · genre: editorial · macrostructure: Split Studio · theme: Garden
   * enrichment: E2 full-bleed decorative video · poster fallback · reduced-motion static image
   * nav: N12 Announcement Banner + Retracting Nav · footer: Ft1 Mast-headed
   * design-system: design.md · pre-emit critique: P5 H5 E5 S5 R5 V4
   */
  .home-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: clamp(38rem, 74dvh, 48rem);
    overflow: clip;
    background: var(--color-ink);
  }

  .home-hero__media,
  .home-hero__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .home-hero__media {
    z-index: -2;
  }

  .home-hero__poster,
  .home-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero__poster {
    display: block;
  }

  .home-hero__video {
    position: absolute;
    inset: 0;
  }

  .home-hero__overlay {
    z-index: -1;
    background: var(--color-hero-overlay);
  }

  .home-hero--overlay-soft .home-hero__overlay {
    background: var(--color-overlay);
  }

  .home-hero__content {
    align-self: center;
    display: grid;
    gap: var(--space-lg);
    min-width: 0;
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .home-hero h1 {
    max-width: 13ch;
    color: var(--color-paper);
    font-size: var(--text-display-s);
    line-height: 1.06;
    overflow-wrap: anywhere;
  }

  .home-hero__lede {
    max-width: 58ch;
    margin: 0;
    color: var(--color-paper);
    font-size: var(--text-md);
    line-height: 1.55;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .home-hero .button--secondary {
    border-color: var(--color-paper);
    color: var(--color-paper);
  }

  .home-hero .editorial-link {
    color: var(--color-paper);
  }

  @media (hover: hover) and (pointer: fine) {
    .home-hero .button--secondary:hover {
      background: var(--color-paper);
      color: var(--color-accent-deep);
    }

    .home-hero .editorial-link:hover {
      color: var(--color-accent-soft);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__video {
      display: none;
    }
  }

  .program-list {
    display: grid;
    gap: var(--space-3xl);
  }

  .media-split__copy > strong {
    color: var(--color-accent-warm-deep);
    font-size: var(--text-sm);
  }

  .vision-statement {
    display: grid;
    gap: var(--space-xl);
  }

  .vision-statement h2 {
    max-width: 10ch;
    color: var(--color-paper);
    font-size: clamp(var(--text-xl), 4vw, var(--text-3xl));
  }

  .vision-statement p {
    max-width: 62ch;
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: clamp(var(--text-lg), 3vw, var(--text-2xl));
    line-height: 1.5;
  }

  .vision-statement .button {
    width: fit-content;
    border-color: var(--color-paper);
    color: var(--color-paper);
  }

  @media (min-width: 60rem) {
    .vision-statement {
      grid-template-columns: minmax(0, 0.45fr) minmax(0, 1.25fr);
      align-items: start;
    }

    .vision-statement .button {
      grid-column: 2;
    }
  }
</style>
