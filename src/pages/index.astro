---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getSiteSettings } from '../lib/site-settings';

const settings = await getSiteSettings();
const heroImage = settings.hero.posterUrl;
const programmes = [
  {
    title: 'SMP Tahfizh',
    target: 'Target hafalan 20 juz',
    href: '/program/smp',
    image: '/images/hero/heroSmp.webp',
    description: 'Tahfizh Al-Qur’an, ilmu diniyah, bahasa Arab, dan kurikulum nasional untuk santri putra tingkat menengah pertama.',
  },
  {
    title: 'SMA Tahfizh',
    target: 'Target hafalan tambahan 10 juz',
    href: '/program/sma',
    image: '/images/hero/heroSma.webp',
    description: 'Pendalaman ilmu syar’i, bahasa Arab aktif, akademik formal, dan pembinaan kemandirian untuk studi lanjut.',
  },
];
---

<Layout title="Beranda - MTQ Tarbiyah Sunnah">
  <main>
    <section class="home-hero">
      <div class="home-hero__media" aria-hidden="true">
        <img
          class="home-hero__poster"
          src={heroImage}
          alt=""
          width="1600"
          height="1200"
          fetchpriority="high"
        />
        <video class="home-hero__video" muted loop playsinline preload="none" aria-hidden="true">
          <source data-src={settings.hero.videoUrl} type="video/mp4" />
        </video>
      </div>
      <div class="home-hero__overlay" aria-hidden="true"></div>
      <div class="page-shell home-hero__content">
        <h1>{settings.hero.headline}</h1>
        <p class="home-hero__lede">
          {settings.hero.lede}
        </p>
        <div class="home-hero__actions">
          <a class="button button--primary" href={settings.header.spmbUrl}>{settings.hero.primaryLabel}</a>
          <a
            class="button button--secondary"
            href={settings.header.brochureUrl || settings.header.spmbUrl}
            target={settings.header.brochureUrl ? '_blank' : undefined}
            rel={settings.header.brochureUrl ? 'noopener noreferrer' : undefined}
          >
            {settings.hero.secondaryLabel}
          </a>
          <a class="editorial-link" href={settings.hero.contactUrl} target="_blank" rel="noopener noreferrer">
            {settings.hero.contactLabel} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="page-section--paper-2">
      <div class="page-shell info-rail" aria-label="Ringkasan program">
        <div>
          <strong>SMP dan SMA khusus putra</strong>
          <p>Tahfizh, diniyah, bahasa Arab, dan akademik formal.</p>
        </div>
        <div>
          <strong>Ijazah resmi negara</strong>
          <p>Pendidikan berasrama dengan pembinaan adab dan kemandirian.</p>
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="page-shell">
        <div class="section-heading">
          <h2>Dua jenjang, satu arah pendidikan.</h2>
          <p>
            Setiap jenjang disusun untuk menjaga kesinambungan hafalan,
            pemahaman agama, kemampuan akademik, dan kesiapan hidup mandiri.
          </p>
        </div>
        <div class="program-list">
          {programmes.map((programme, index) => (
            <article class={`media-split ${index % 2 ? 'media-split--reverse' : ''}`}>
              <figure class="media-split__figure">
                <img
                  src={programme.image}
                  alt={`Kegiatan ${programme.title}`}
                  width="1200"
                  height="900"
                  loading="lazy"
                />
              </figure>
              <div class="media-split__copy">
                <h3>{programme.title}</h3>
                <strong>{programme.target}</strong>
                <p>{programme.description}</p>
                <a class="editorial-link" href={programme.href}>
                  Lihat program <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="page-section page-section--ink">
      <div class="page-shell vision-statement">
        <h2>Visi Ma’had</h2>
        <p>
          “Menjadi lembaga pendidikan Islam yang unggul dalam mencetak
          penghafal Al-Qur’an yang berakidah Ahlussunnah wal Jamaah, berakhlak
          mulia, mampu berbahasa Arab, berilmu, dan mandiri.”
        </p>
        <a class="button button--secondary" href="/profil-mahad">Baca profil Ma’had</a>
      </div>
    </section>
  </main>
</Layout>

<script>
  const video = document.querySelector<HTMLVideoElement>('.home-hero__video');
  const source = video?.querySelector<HTMLSourceElement>('source[data-src]');
  const connection = navigator.connection as (NetworkInformation & { saveData?: boolean }) | undefined;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const startVideo = () => {
    if (!video || !source || reduceMotion || connection?.saveData) return;
    source.src = source.dataset.src ?? '';
    video.addEventListener('canplay', () => {
      video.classList.add('is-ready');
      void video.play().catch(() => undefined);
    }, { once: true });
    video.load();
  };

  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(startVideo, { timeout: 2500 });
  } else {
    window.setTimeout(startVideo, 1200);
  }
</script>

<style>
  /* Hallmark · genre: editorial · macrostructure: Split Studio · theme: Garden
   * enrichment: E2 full-bleed decorative video · poster fallback · reduced-motion static image
   * nav: N12 Announcement Banner + Retracting Nav · footer: Ft1 Mast-headed
   * design-system: design.md · pre-emit critique: P5 H5 E5 S5 R5 V4
   */
  .home-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: clamp(38rem, 74dvh, 48rem);
    overflow: clip;
    background: var(--color-ink);
  }

  .home-hero__media,
  .home-hero__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .home-hero__media {
    z-index: -2;
  }

  .home-hero__poster,
  .home-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-hero__poster {
    display: block;
  }

  .home-hero__video {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }

  .home-hero__video.is-ready { visibility: visible; }

  .home-hero__overlay {
    z-index: -1;
    background: var(--color-hero-overlay);
  }

  .home-hero__content {
    align-self: center;
    display: grid;
    gap: var(--space-lg);
    min-width: 0;
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .home-hero h1 {
    max-width: 13ch;
    color: var(--color-paper);
    font-size: var(--text-display-s);
    line-height: 1.06;
    overflow-wrap: anywhere;
  }

  .home-hero__lede {
    max-width: 58ch;
    margin: 0;
    color: var(--color-paper);
    font-size: var(--text-md);
    line-height: 1.55;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .home-hero .button--secondary {
    border-color: var(--color-paper);
    color: var(--color-paper);
  }

  .home-hero .editorial-link {
    color: var(--color-paper);
  }

  @media (hover: hover) and (pointer: fine) {
    .home-hero .button--secondary:hover {
      background: var(--color-paper);
      color: var(--color-accent-deep);
    }

    .home-hero .editorial-link:hover {
      color: var(--color-accent-soft);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__video {
      display: none;
    }
  }

  .program-list {
    display: grid;
    gap: var(--space-3xl);
  }

  .media-split__copy > strong {
    color: var(--color-accent-warm-deep);
    font-size: var(--text-sm);
  }

  .vision-statement {
    display: grid;
    gap: var(--space-xl);
  }

  .vision-statement h2 {
    max-width: 10ch;
    color: var(--color-paper);
    font-size: clamp(var(--text-xl), 4vw, var(--text-3xl));
  }

  .vision-statement p {
    max-width: 62ch;
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: clamp(var(--text-lg), 3vw, var(--text-2xl));
    line-height: 1.5;
  }

  .vision-statement .button {
    width: fit-content;
    border-color: var(--color-paper);
    color: var(--color-paper);
  }

  @media (min-width: 60rem) {
    .vision-statement {
      grid-template-columns: minmax(0, 0.45fr) minmax(0, 1.25fr);
      align-items: start;
    }

    .vision-statement .button {
      grid-column: 2;
    }
  }
</style>
