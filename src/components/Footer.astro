---
import type { PublicSiteSettings } from '../lib/site-settings';
const year = new Date().getFullYear();
const { settings } = Astro.props as { settings: PublicSiteSettings };
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__mast">
      <a class="site-footer__brand" href="/">
        <img src={settings.branding.logoUrl} width="784" height="560" alt="" loading="lazy" />
        <span>{settings.branding.siteShortName}</span>
      </a>
      <p>{settings.footer.description}</p>
      <nav aria-label="Navigasi footer">
        {settings.navigation.footer.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
    <div class="site-footer__meta">
      <address>
        {settings.footer.address}
      </address>
      <a href={`tel:${settings.footer.phone.replace(/\s/g, '')}`}>{settings.footer.phone}</a>
      <p>© {year} {settings.footer.copyrightOwner}</p>
    </div>
  </div>
</footer>
