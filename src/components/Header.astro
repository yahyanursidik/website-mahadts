---
import pengaturanUtama from '../content/pengaturanUtama/data.json';
import { getSiteSettings } from '../lib/directus';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => href === '/'
  ? pathname === '/'
  : pathname === href || pathname.startsWith(`${href}/`);
const siteSettings = await getSiteSettings();
const spmbUrl = siteSettings?.spmb_url || pengaturanUtama.linkSpmb || 'https://hub.mahadtarbiyahsunnah.com/login/spmb';
---
<header class="site-nav" id="site-nav">
  <div class="site-nav__banner" id="site-banner">
    <p>
      Penerimaan murid baru sedang dibuka.
      <a href={spmbUrl}>Lihat informasi SPMB <span aria-hidden="true">→</span></a>
    </p>
    <button class="site-nav__banner-close" id="banner-close" type="button" aria-label="Tutup pengumuman">
      <span class="material-symbols-outlined" aria-hidden="true">close</span>
    </button>
  </div>

  <div class="site-nav__bar">
    <div class="site-nav__inner">
      <a class="site-brand" href="/" aria-label="MTQ Tarbiyah Sunnah — Beranda">
        <img src="/images/settings/favicon.png" width="784" height="560" alt="" />
        <span>
          <strong>MTQ</strong>
          <small>Tarbiyah Sunnah</small>
        </span>
      </a>

      <nav class="site-nav__links" aria-label="Navigasi utama">
        <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Beranda</a>
        <a href="/profil-mahad" aria-current={isCurrent('/profil-mahad') ? 'page' : undefined}>Profil</a>
        <details class="site-nav__program">
          <summary aria-current={pathname.startsWith('/program') ? 'page' : undefined}>
            Program
            <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
          </summary>
          <div class="site-nav__dropdown">
            <a href="/program/smp" aria-current={isCurrent('/program/smp') ? 'page' : undefined}>
              <span>Program SMP</span>
              <small>Tahfizh dan akademik tingkat menengah pertama</small>
            </a>
            <a href="/program/sma" aria-current={isCurrent('/program/sma') ? 'page' : undefined}>
              <span>Program SMA</span>
              <small>Persiapan studi lanjut dengan pembinaan terpadu</small>
            </a>
          </div>
        </details>
        <a href="/artikel" aria-current={isCurrent('/artikel') ? 'page' : undefined}>Artikel</a>
        <a href="/hubungi-kami" aria-current={isCurrent('/hubungi-kami') ? 'page' : undefined}>Kontak</a>
      </nav>

      <div class="site-nav__actions">
        <a class="button button--primary site-nav__cta" href={spmbUrl}>
          Daftar SPMB
        </a>
        <button class="site-nav__menu-button" id="mobile-menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Buka menu">
          <span class="material-symbols-outlined" aria-hidden="true">menu</span>
        </button>
      </div>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Navigasi seluler">
      <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Beranda</a>
      <a href="/profil-mahad" aria-current={isCurrent('/profil-mahad') ? 'page' : undefined}>Profil Ma’had</a>
      <span class="mobile-menu__label">Program</span>
      <a href="/program/smp" aria-current={isCurrent('/program/smp') ? 'page' : undefined}>Program SMP</a>
      <a href="/program/sma" aria-current={isCurrent('/program/sma') ? 'page' : undefined}>Program SMA</a>
      <a href="/artikel" aria-current={isCurrent('/artikel') ? 'page' : undefined}>Artikel</a>
      <a href="/hubungi-kami" aria-current={isCurrent('/hubungi-kami') ? 'page' : undefined}>Hubungi Kami</a>
      <a class="button button--primary" href={spmbUrl}>Daftar SPMB</a>
    </nav>
  </div>
</header>

<script>
  const initNavigation = () => {
    const header = document.getElementById('site-nav');
    const bannerClose = document.getElementById('banner-close');
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = menuButton?.querySelector('.material-symbols-outlined');
    let previousY = window.scrollY;

    if (!header || header.dataset.navigationReady === 'true') return;
    header.dataset.navigationReady = 'true';

    const closeMobileMenu = () => {
      if (!menuButton || !mobileMenu) return;
      menuButton.setAttribute('aria-expanded', 'false');
      menuButton.setAttribute('aria-label', 'Buka menu');
      mobileMenu.hidden = true;
      if (menuIcon) menuIcon.textContent = 'menu';
    };

    const onScroll = () => {
      const currentY = window.scrollY;
      const scrollingDown = currentY > previousY;
      header.classList.toggle('is-compact', currentY > 48 && scrollingDown);
      if (currentY < 16) header.classList.remove('is-compact');
      previousY = currentY;
    };

    window.addEventListener('scroll', onScroll, { passive: true });

    bannerClose?.addEventListener('click', () => {
      header.classList.add('is-dismissed');
      document.documentElement.style.setProperty('--banner-h', '0px');
      sessionStorage.setItem('mtq-banner-dismissed', 'true');
    });

    if (sessionStorage.getItem('mtq-banner-dismissed') === 'true') {
      header.classList.add('is-dismissed');
      document.documentElement.style.setProperty('--banner-h', '0px');
    }

    menuButton?.addEventListener('click', () => {
      if (!mobileMenu) return;
      const willOpen = mobileMenu.hidden;
      mobileMenu.hidden = !willOpen;
      menuButton.setAttribute('aria-expanded', String(willOpen));
      menuButton.setAttribute('aria-label', willOpen ? 'Tutup menu' : 'Buka menu');
      if (menuIcon) menuIcon.textContent = willOpen ? 'close' : 'menu';
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMobileMenu();
        document.querySelectorAll<HTMLDetailsElement>('.site-nav__program[open]').forEach((detail) => {
          detail.open = false;
        });
      }
    });

    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      document.querySelectorAll<HTMLDetailsElement>('.site-nav__program[open]').forEach((detail) => {
        if (!detail.contains(target)) detail.open = false;
      });
    });

    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMobileMenu);
    });
  };

  document.addEventListener('astro:page-load', initNavigation);
  if (document.readyState !== 'loading') {
    initNavigation();
  } else {
    document.addEventListener('DOMContentLoaded', initNavigation, { once: true });
  }
</script>
