---
import '../../tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteSettings } from '../lib/site-settings';

interface Props {
  title: string;
}

const { title } = Astro.props;
const settings = await getSiteSettings();
const faviconUrl = settings.branding.faviconUrl || '/favicon.svg';
const description = settings.seo.defaultDescription;
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta property="og:image" content={settings.seo.ogImageUrl} />
  <link rel="icon" type="image/png" href={faviconUrl} />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body class="site-body">
  <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
  <Header settings={settings} />
  <div class="site-content" id="main-content" tabindex="-1">
    <slot />
  </div>
  <Footer settings={settings} />
</body>
</html>
